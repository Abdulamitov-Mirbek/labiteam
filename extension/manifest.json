{
  "manifest_version": 3,
  "name": "Tolkun — связь в объявлениях",
  "version": "1.1.0",
  "description": "Показывает качество мобильной связи в объявлениях house.kg и lalafo.kg и принимает жалобы «Здесь нет связи».",
  "host_permissions": [
    "https://house.kg/*",
    "https://www.house.kg/*",
    "https://lalafo.kg/*",
    "https://www.lalafo.kg/*",
    "https://tolkun.online/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://house.kg/details/*",
        "https://www.house.kg/details/*",
        "https://lalafo.kg/*",
        "https://www.lalafo.kg/*"
      ],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
