<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сигнал.kg — замер связи"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Измеряет силу сигнала (dBm) вашего телефона и отправляет оператору вместе с местом по GPS."
            android:textSize="14sp"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Адрес сервера"
            android:textSize="12sp"
            android:textAllCaps="true" />

        <EditText
            android:id="@+id/server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:text="https://tolkun.online"
            android:textSize="15sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/measure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Замерить и отправить"
            android:textSize="17sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

        <TextView
            android:id="@+id/dbm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="52sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="24dp" />

        <TextView
            android:id="@+id/dbmUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="dBm · RSRP"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сеть: —"
            android:textSize="16sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Место: —"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Нажмите «Замерить», чтобы начать."
            android:textSize="15sp"
            android:paddingTop="8dp" />

    </LinearLayout>
</ScrollView>
